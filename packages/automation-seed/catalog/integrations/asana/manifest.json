{
  "id": "asana",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "1.0.0",
  "name": "Asana",
  "vendor": "Asana",
  "description": "Create and list tasks in Asana projects.",
  "intentHints": [
    "create an asana task",
    "list my asana tasks"
  ],
  "authType": "oauth2",
  "_authNote": "OAuth endpoints, scopes, client secret ref and any identity step are PLATFORM-OWNED \u2014 they live in the private clarity-api (integrations-v2/config/oauth-configs.ts), never in this public repo. This manifest only declares that the integration uses oauth2 and which tools it provides.",
  "providedTools": [
    {
      "id": "asana.create_task",
      "description": "Create a task.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        },
        "name": {
          "type": "string",
          "required": true
        },
        "notes": {
          "type": "string",
          "required": false
        }
      },
      "output": {
        "task_id": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "id": "asana.list_tasks",
      "description": "List tasks.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "tasks": {
          "type": "array",
          "required": true
        }
      }
    }
  ]
}
