{
  "id": "linear",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "1.0.0",
  "name": "Linear",
  "vendor": "Linear",
  "description": "Create issues, search, and comment in the user's Linear workspace.",
  "intentHints": [
    "create a linear issue",
    "find linear tickets",
    "comment on a linear issue"
  ],
  "authType": "oauth2",
  "_authNote": "OAuth endpoints, scopes, client secret ref and any identity step are PLATFORM-OWNED \u2014 they live in the private clarity-api (integrations-v2/config/oauth-configs.ts), never in this public repo. This manifest only declares that the integration uses oauth2 and which tools it provides.",
  "providedTools": [
    {
      "id": "linear.create_issue",
      "description": "Create an issue.",
      "input": {
        "team_id": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        },
        "description": {
          "type": "string",
          "required": false
        }
      },
      "output": {
        "issue_id": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "id": "linear.search_issues",
      "description": "Search issues.",
      "input": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "issues": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "id": "linear.add_comment",
      "description": "Comment on an issue.",
      "input": {
        "issue_id": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "comment_id": {
          "type": "string",
          "required": true
        }
      }
    }
  ]
}
