{
  "id": "trello",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "0.1.0",
  "name": "Trello",
  "vendor": "Atlassian",
  "description": "Create cards and list cards across Trello boards.",
  "intentHints": [
    "create a trello card",
    "list trello cards"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "trello.create_card",
      "description": "Create a card.",
      "input": {
        "list_id": {
          "type": "string",
          "required": true
        },
        "name": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "card_id": {
          "type": "string",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "trello.list_cards",
      "description": "List cards on a board.",
      "input": {
        "board_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "cards": {
          "type": "array",
          "required": true
        }
      },
      "local": false
    }
  ],
  "credentialFields": [
    {
      "key": "app_key",
      "label": "API Key",
      "type": "text",
      "required": true,
      "help": "trello.com/app-key (the public application key)."
    },
    {
      "key": "token",
      "label": "Token",
      "type": "password",
      "required": true,
      "help": "The user token generated from your API key."
    }
  ],
  "localConnector": false,
  "_localNote": "Studio CANNOT broker this yet: no connector in packages/connectors. Calling any of these tools from an automation will fail at run time. See .claude/skills/add-an-integration/SKILL.md to request one."
}
