{
  "id": "mailchimp",
  "kind": "integration",
  "category": "marketing",
  "transport": "native",
  "version": "0.1.0",
  "name": "Mailchimp",
  "vendor": "Mailchimp",
  "description": "Add subscribers and send campaigns.",
  "intentHints": [
    "add a subscriber",
    "send a campaign"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "mailchimp.add_subscriber",
      "description": "Add a subscriber to an audience.",
      "input": {
        "audience_id": {
          "type": "string",
          "required": true
        },
        "email": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "ok": {
          "type": "boolean",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "mailchimp.send_campaign",
      "description": "Send a prepared campaign.",
      "input": {
        "campaign_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "ok": {
          "type": "boolean",
          "required": true
        }
      },
      "local": false
    }
  ],
  "credentialFields": [
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true,
      "help": "Account → Extras → API keys."
    },
    {
      "key": "server_prefix",
      "label": "Server prefix",
      "type": "text",
      "required": true,
      "placeholder": "us21",
      "help": "The data-center suffix of your API key (the part after the dash)."
    }
  ],
  "localConnector": false,
  "_localNote": "Studio CANNOT broker this yet: no connector in packages/connectors. Calling any of these tools from an automation will fail at run time. See .claude/skills/add-an-integration/SKILL.md to request one."
}
