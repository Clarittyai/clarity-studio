{
  "id": "notion",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "1.0.0",
  "name": "Notion",
  "vendor": "Notion",
  "description": "Search, read, create, and update pages in the user's Notion workspace.",
  "intentHints": [
    "search notion",
    "create a notion page",
    "update a notion doc"
  ],
  "authType": "oauth2",
  "_authNote": "OAuth endpoints, scopes, client secret ref and any identity step are PLATFORM-OWNED — they live in the private clarity-api (integrations-v2/config/oauth-configs.ts), never in this public repo. This manifest only declares that the integration uses oauth2 and which tools it provides.",
  "providedTools": [
    {
      "id": "notion.search",
      "description": "Search pages.",
      "input": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "results": {
          "type": "array",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "notion.create_page",
      "description": "Create a page.",
      "input": {
        "parent_id": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        },
        "content": {
          "type": "string",
          "required": false
        }
      },
      "output": {
        "page_id": {
          "type": "string",
          "required": true
        }
      },
      "local": true
    },
    {
      "id": "notion.update_page",
      "description": "Update a page.",
      "input": {
        "page_id": {
          "type": "string",
          "required": true
        },
        "properties": {
          "type": "object",
          "required": true
        }
      },
      "output": {
        "ok": {
          "type": "boolean",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "notion.query_database",
      "description": "Query a database.",
      "local": true
    }
  ],
  "localConnector": true,
  "_localNote": "Studio can broker this. Only tools marked \"local\": true can be called — the rest are hosted-platform only."
}
