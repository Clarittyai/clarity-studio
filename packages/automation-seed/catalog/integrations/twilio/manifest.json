{
  "id": "twilio",
  "kind": "integration",
  "category": "communication",
  "transport": "native",
  "version": "1.0.0",
  "name": "Twilio",
  "vendor": "Twilio",
  "description": "Send SMS and place voice calls.",
  "intentHints": [
    "text me",
    "send an sms",
    "call a number"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "twilio.send_sms",
      "description": "Send an SMS.",
      "input": {
        "to": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "sid": {
          "type": "string",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "twilio.make_call",
      "description": "Place a voice call.",
      "input": {
        "to": {
          "type": "string",
          "required": true
        },
        "twiml_url": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "sid": {
          "type": "string",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "twilio.send_whatsapp",
      "description": "Send a WhatsApp message (via a WhatsApp-enabled Twilio sender).",
      "input": {
        "to": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "sid": {
          "type": "string",
          "required": true
        }
      },
      "local": false
    }
  ],
  "credentialFields": [
    {
      "key": "account_sid",
      "label": "Account SID",
      "type": "text",
      "required": true,
      "placeholder": "ACxxxxxxxx",
      "help": "Twilio Console → Account Info."
    },
    {
      "key": "auth_token",
      "label": "Auth Token",
      "type": "password",
      "required": true,
      "help": "Twilio Console → Account Info (kept secret)."
    },
    {
      "key": "from_number",
      "label": "From number",
      "type": "text",
      "required": true,
      "placeholder": "+14155551234",
      "help": "A Twilio phone number you own."
    }
  ],
  "localConnector": false,
  "_localNote": "Studio CANNOT broker this yet: no connector in packages/connectors. Calling any of these tools from an automation will fail at run time. See .claude/skills/add-an-integration/SKILL.md to request one."
}
