{
  "id": "gitlab",
  "kind": "integration",
  "category": "dev",
  "transport": "native",
  "version": "1.0.0",
  "name": "GitLab",
  "vendor": "GitLab",
  "description": "List issues and create merge requests in GitLab.",
  "intentHints": [
    "gitlab issues",
    "open a merge request"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "gitlab.list_issues",
      "description": "List issues in a project.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "issues": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "id": "gitlab.create_mr",
      "description": "Create a merge request.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        },
        "source_branch": {
          "type": "string",
          "required": true
        },
        "target_branch": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "iid": {
          "type": "integer",
          "required": true
        }
      }
    }
  ]
}
