{
  "id": "gitlab",
  "kind": "integration",
  "category": "dev",
  "transport": "native",
  "version": "1.0.0",
  "name": "GitLab",
  "vendor": "GitLab",
  "description": "List issues and create merge requests in GitLab.",
  "intentHints": [
    "gitlab issues",
    "open a merge request"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "gitlab.list_issues",
      "description": "List issues in a project.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "issues": {
          "type": "array",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "gitlab.create_mr",
      "description": "Create a merge request.",
      "input": {
        "project_id": {
          "type": "string",
          "required": true
        },
        "source_branch": {
          "type": "string",
          "required": true
        },
        "target_branch": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "iid": {
          "type": "integer",
          "required": true
        }
      },
      "local": false
    }
  ],
  "localConnector": false,
  "_localNote": "Studio CANNOT broker this yet: no connector in packages/connectors. Calling any of these tools from an automation will fail at run time. See .claude/skills/add-an-integration/SKILL.md to request one."
}
