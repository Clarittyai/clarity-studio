{
  "id": "clickup",
  "kind": "integration",
  "category": "productivity",
  "transport": "native",
  "version": "1.0.0",
  "name": "ClickUp",
  "vendor": "ClickUp",
  "description": "Create and list tasks in ClickUp.",
  "intentHints": [
    "clickup task",
    "list clickup tasks"
  ],
  "authType": "apiKey",
  "providedTools": [
    {
      "id": "clickup.create_task",
      "description": "Create a task.",
      "input": {
        "list_id": {
          "type": "string",
          "required": true
        },
        "name": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "task_id": {
          "type": "string",
          "required": true
        }
      },
      "local": false
    },
    {
      "id": "clickup.list_tasks",
      "description": "List tasks.",
      "input": {
        "list_id": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "tasks": {
          "type": "array",
          "required": true
        }
      },
      "local": false
    }
  ],
  "localConnector": false,
  "_localNote": "Studio CANNOT broker this yet: no connector in packages/connectors. Calling any of these tools from an automation will fail at run time. See .claude/skills/add-an-integration/SKILL.md to request one."
}
