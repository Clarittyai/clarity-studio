{
  "name": "@clarity-studio/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev": "vite",
    "preview": "vite preview --port 5199 --strictPort",
    "start": "electron .",
    "package": "electron-builder --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@clarity-studio/agent-bridge": "workspace:*",
    "@clarity-studio/connectors": "workspace:*",
    "@clarity-studio/control-plane": "workspace:*",
    "@clarity-studio/db": "workspace:*",
    "@clarity-studio/design": "workspace:*",
    "@clarity-studio/graph": "workspace:*",
    "@clarity-studio/orchestrator": "workspace:*",
    "@clarity-studio/scheduler": "workspace:*",
    "@clarity-studio/vault": "workspace:*",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "productName": "Claritty Studio",
    "appId": "ai.clarity.studio",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
